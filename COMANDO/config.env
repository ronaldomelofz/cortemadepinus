# Configuracao do INICIAR-SISTEMA.bat (opcional)
# Copie este arquivo para config.env e ajuste se precisar.

PORTA=4000
SITE_NETLIFY=https://cortemadepinus.netlify.app

# 1 = se a URL do tunel mudar, atualiza VITE_API_URL e faz deploy no Netlify
# 0 = so sobe API + tunel (mais rapido no boot)
ATUALIZAR_NETLIFY=1

# ngrok | cloudflare
PREFERIR_TUNEL=ngrok
