# ---------------------------------------------------------------
# Variaveis usadas pelo docker-compose no servidor local MadePinus
# Copie para .env e ajuste antes de subir os containers
# ---------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=madepinus
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cortemadepinus
POSTGRES_PORT=5432

# API
API_PORT=4000
JWT_SECRET=gere-com-node-e-crypto-randomBytes-48-hex
JWT_EXPIRES_IN=7d
MAX_UPLOAD_MB=20

# Origens autorizadas do front-end (separadas por virgula)
CORS_ORIGINS=https://cortemadepinus.netlify.app,http://localhost:5173

# Administrador criado automaticamente
ADMIN_NOME=Central de Servicos MadePinus
ADMIN_EMAIL=admin@madepinus.com.br
ADMIN_SENHA=troque-este-acesso

# Cloudflare Tunnel (opcional): docker compose --profile tunel up -d
TUNNEL_TOKEN=
