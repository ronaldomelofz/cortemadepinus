# ---------------------------------------------------------------
# API da Central de Servicos MadePinus
# Copie para .env e ajuste os valores
# ---------------------------------------------------------------

NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------
# sqlite      -> nao precisa instalar nada nem ter senha. O banco vira um
#                arquivo em apps/api/dados/cortemadepinus.db. Recomendado
#                para a central de servicos rodando em um unico servidor.
# postgresql  -> use quando o banco for gerenciado ou compartilhado.
DB_PROVIDER=sqlite

# Com DB_PROVIDER=sqlite pode deixar em branco (usa o arquivo padrao):
# DATABASE_URL="file:./dados/cortemadepinus.db"

# Com DB_PROVIDER=postgresql a URL e obrigatoria:
# DATABASE_URL="postgresql://madepinus:senha@localhost:5432/cortemadepinus?schema=public"

# ---------------------------------------------------------------
# Seguranca
# ---------------------------------------------------------------
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-por-uma-chave-aleatoria-longa"
JWT_EXPIRES_IN=7d

# Origens autorizadas (separadas por virgula).
# Mantenha o Netlify para o site publico. A rede local (192.168.x.x) e liberada no codigo.
CORS_ORIGINS=http://localhost:5173,https://cortemadepinus.netlify.app

# ---------------------------------------------------------------
# Arquivos e administrador
# ---------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

ADMIN_NOME="Ronaldo"
ADMIN_EMAIL=ronaldomelofz@gmail.com
ADMIN_SENHA=TroqueEstaSenha123

OPERADOR_NOME="Operador de Produção"
OPERADOR_EMAIL=operador@madepinus.com.br
OPERADOR_SENHA=TroqueOperador123

VENDEDOR_NOME="Vendedor MadePinus"
VENDEDOR_EMAIL=vendedor@madepinus.com.br
VENDEDOR_SENHA=TroqueVendedor123

# WhatsApp (Evolution API ou compatível). Com WHATSAPP_ENABLED=false, mensagens vão só para o log.
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://sua-evolution-api.com
WHATSAPP_INSTANCE=madepinus
WHATSAPP_API_KEY=sua-chave-api
# Telefone do operador para alertas (DDD + número). Se vazio, usa o telefone do usuário operador no banco.
OPERADOR_TELEFONE=5511999999999
