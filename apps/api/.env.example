# ---------------------------------------------------------------
# API da Central de Servicos MadePinus
# Copie para .env e ajuste os valores
# ---------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL hospedado no seu servidor local
DATABASE_URL="postgresql://madepinus:madepinus@localhost:5432/cortemadepinus?schema=public"

# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-por-uma-chave-aleatoria-longa"
JWT_EXPIRES_IN=7d

# Origens autorizadas (separadas por virgula)
CORS_ORIGINS=http://localhost:5173,https://cortemadepinus.netlify.app

# Armazenamento dos anexos enviados pelos clientes
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# Usuario administrador criado pelo seed
ADMIN_NOME="Central de Servicos MadePinus"
ADMIN_EMAIL=admin@madepinus.com.br
ADMIN_SENHA=MudarEsteAcesso1
